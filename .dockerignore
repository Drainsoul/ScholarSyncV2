# Keep secrets, local state and build output out of the image.
.git
.gitignore
.gitattributes
.env
.env.*
!.env.example
.venv
.mypy_cache
.ruff_cache
.pytest_cache
__pycache__
*.pyc
frontend/node_modules
static/dist
staticfiles
# Notes and editor or tool settings: no dotfile and no Markdown file belongs in the image, except the
# third-party notices, which ship with the bundled icons and fonts.
.*
!.env.example
*.md
!THIRD_PARTY_NOTICES.md
.idea
.vscode
tests/e2e
docs
.devcontainer/explore.env
