# ScholarSync configuration. Copy this file to .env and edit it.
# It holds placeholders only. Never put real secrets in this tracked file.
#
# `docker compose up` (explore mode) needs no .env at all: compose supplies its own values.
# Self-hosting: use compose.production.yaml with this file as .env (see docs/HOSTING.md).
# Every variable below is read by config/settings.py, except DATABASE_URL_UNPOOLED, which
# docker/entrypoint.sh reads, and the compose ports at the bottom.
# "Required" means the app refuses to start without it in production, unless the line says
# "for real use" (the app starts, but that feature does not work).

# ======================================================================================
# Local development (the developer workflow: runserver, with the compose `db` service)
# These values suit a laptop. Replace every one of them for a real deployment.
# ======================================================================================

# Debug mode and Django's developer conveniences. true/false. Production: false (the default).
DJANGO_DEBUG=true
# Local database from compose.yaml on host port 5433 (development credentials only).
# Use 127.0.0.1, not localhost: compose publishes the port on IPv4 loopback only.
# Production: your own PostgreSQL 17, see "Database" below.
DATABASE_URL=postgres://scholarsync:scholarsync@127.0.0.1:5433/scholarsync
# Load the Vite dev server (npm --prefix frontend run dev) instead of the built bundle.
# true/false. Local development only.
VITE_DEV_MODE=false
# The design kit at /_kit/. true/false, defaults to on in debug and explore modes.
# The app refuses to start with this on in production, so leave it unset there.
DJANGO_KIT=true
# true = the browser only reports Content-Security-Policy violations; false = it enforces them.
# Default true. Set false in production once your pages load without reports.
CSP_REPORT_ONLY=true

# ======================================================================================
# Core
# ======================================================================================

# Required. The secret key that signs sessions and tokens. At least 50 random characters.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Keys starting with "explore-only-" are refused in production.
DJANGO_SECRET_KEY=local-dev-only-change-me-0123456789abcdef0123456789abcdef
# Required in production. Comma-separated host names the app answers to.
# Example: scholarships.example.gov.ph
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Required in production when you serve over HTTPS. Comma-separated origins with the scheme.
# Example: https://scholarships.example.gov.ph
DJANGO_CSRF_TRUSTED_ORIGINS=
# Required in production. Who runs this copy: shown on the privacy, terms and contact pages.
# Use your organisation's legal name. Explore and developer copies default to "This local copy".
SITE_OPERATOR_NAME=Example Organisation change-me
# Required in production. Where people send privacy requests (access, correction, erasure).
# Use an address you read. Explore and developer copies default to blank.
# Example: privacy@example.org
PRIVACY_CONTACT_EMAIL=privacy@example.org
# Log level for the JSON logs on stdout: DEBUG, INFO, WARNING or ERROR. Default INFO.
LOG_LEVEL=INFO

# ======================================================================================
# Modes
# ======================================================================================

# Explore mode: serves only localhost and 127.0.0.1 over HTTP, loads the demo accounts
# and turns the design kit on. docker compose sets it for you. Never set it on a real host.
# true/false. Default false (production).
SCHOLARSYNC_EXPLORE=false

# ======================================================================================
# Database (PostgreSQL 17)
# ======================================================================================

# Required: DATABASE_URL, set in the Local development block at the top.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME. Any PostgreSQL 17 works (your own
# server, or a managed one such as Neon, Supabase or RDS).

# Optional. A direct (non-pooled) URL for migrations, used by docker/entrypoint.sh when
# DATABASE_URL goes through a transaction pooler such as PgBouncer or a pooled Neon host.
# Leave blank when DATABASE_URL connects straight to PostgreSQL.
DATABASE_URL_UNPOOLED=

# ======================================================================================
# Email
# ======================================================================================

# Required for real use. Blank sends emails to the log instead. One URL for your SMTP server:
#   smtp://USER:PASSWORD@HOST:25            plain
#   smtp+tls://USER:PASSWORD@HOST:587       STARTTLS
#   smtps://USER:PASSWORD@HOST:465          implicit TLS
# URL-encode special characters in the password. Blank or console:// prints emails to the log.
# Get the details from your email provider's SMTP settings.
# Example: smtp+tls://apikey:change-me@smtp.example.com:587
EMAIL_URL=
# The From address on every email. Use an address your SMTP provider allows.
DEFAULT_FROM_EMAIL=ScholarSync <no-reply@localhost>

# ======================================================================================
# File storage (any S3-compatible service: R2, S3, Garage, SeaweedFS, MinIO)
# ======================================================================================
# Browsers upload and download directly through presigned URLs, so the service must allow
# CORS from your site and be reachable from the browser.

# Required for real use (uploads). The S3 API endpoint the app uses.
# Example: https://ACCOUNT.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
# Optional. The endpoint browsers use, when it differs from S3_ENDPOINT_URL (for example the
# app reaches storage as http://storage:9000 inside Docker, but browsers need http://localhost:9000).
# It also joins the Content-Security-Policy img-src and connect-src lists.
S3_PUBLIC_ENDPOINT_URL=
# Required for real use (uploads). The signing region. Example: auto (R2), us-east-1 (S3 and most others).
S3_REGION=
# Required for real use (uploads). The bucket name. Create it first.
S3_BUCKET=
# Required for real use (uploads). The access key ID from your storage provider's console.
S3_ACCESS_KEY_ID=
# Required for real use (uploads). The secret access key from your storage provider's console.
S3_SECRET_ACCESS_KEY=
# path (http://host/bucket/key, the default, works with most servers) or virtual
# (http://bucket.host/key, what AWS S3 prefers).
S3_ADDRESSING_STYLE=path

# ======================================================================================
# Error tracking (optional)
# ======================================================================================

# Sentry DSN from your Sentry project settings. Blank turns error tracking off.
SENTRY_DSN=
# The environment tag on Sentry events. Default: production, or local when not in production.
SENTRY_ENVIRONMENT=local
# A release label (for example a git SHA) so Sentry can group errors by version. Optional.
SENTRY_RELEASE=

# ======================================================================================
# Compose host ports (docker compose only, not read by Django)
# ======================================================================================
# Every published port is bound to 127.0.0.1. Change one when its default is taken, for
# example: APP_PORT=8080 docker compose up. Production: put a TLS proxy in front of APP_PORT.

# The app. compose.yaml and compose.production.yaml. Default 8000.
APP_PORT=8000
# The Mailpit inbox (compose.yaml only). Default 8025.
MAIL_PORT=8025
# PostgreSQL on the host (compose.yaml only). Default 5433.
DB_PORT=5433
# The S3-compatible storage (compose.yaml only). Default 9000.
STORAGE_PORT=9000
