# Copy to .env for local development. Never put real secrets here (spec §14 lists every variable).
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-dev-only-not-a-secret-change-me-0123456789abcdef
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Local Postgres from compose.yaml on host port 5433 (development credentials only)
DATABASE_URL=postgres://scholarsync:scholarsync@localhost:5433/scholarsync
DATABASE_URL_UNPOOLED=
VITE_DEV_MODE=false
CSP_REPORT_ONLY=true
# Design kit at /_kit/ (defaults to DJANGO_DEBUG; refused when VERCEL_ENV=production)
DJANGO_KIT=true
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
